# Copy to .env and fill in real values. Never commit the actual .env.

# JWT signing secret (RBAC: operator vs propulsion_engineer). The app
# refuses to start if this is empty.
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRE_MINUTES=60

# Shared secret used to sign/verify inbound UDP telemetry packets (spoof
# prevention on the local telemetry link). The app refuses to start if this
# is empty.
MAVLINK_SHARED_SECRET=change-me-too
MAVLINK_SIGNATURE_MAX_AGE=5.0

# Separate secret gating the dev-only /auth/token endpoint used to mint
# JWTs before real user management exists. NOT the same thing as a user
# password — anyone holding this can mint a token for ANY role. Keep it
# out of anything beyond local dev.
BOOTSTRAP_SECRET=change-me-a-third-time

LOG_LEVEL=INFO
RING_BUFFER_SIZE=100
