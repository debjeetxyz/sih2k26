# Copy to .env and fill in real values. Never commit the actual .env.

# JWT signing secret (RBAC: operator vs propulsion_engineer)
JWT_SECRET=change-me-to-a-long-random-value

# MAVLink v2 shared secret used for packet signing / spoof prevention
MAVLINK_SHARED_SECRET=change-me-too

LOG_LEVEL=INFO
RING_BUFFER_SIZE=100
